{
  "name": "@mindra.dev/core",
  "version": "0.3.0",
  "description": "Element-level user familiarity, friction and confidence scoring. Local-first, zero dependencies, no backend required.",
  "keywords": [
    "adaptive-ui",
    "user-experience",
    "telemetry",
    "personalization",
    "onboarding",
    "progressive-disclosure",
    "local-first"
  ],
  "license": "MIT",
  "author": "Sidhanshu Monga",
  "homepage": "https://www.mindra.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhanshumonga/mindra-dev.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sidhanshumonga/mindra-dev/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
