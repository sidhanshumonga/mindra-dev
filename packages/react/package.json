{
  "name": "@mindra/react",
  "version": "0.1.0",
  "description": "React bindings for Mindra. Adapt copy, tooltips and confirmation flows to how familiar each user is with each element.",
  "keywords": [
    "react",
    "adaptive-ui",
    "user-experience",
    "personalization",
    "onboarding",
    "progressive-disclosure",
    "hooks"
  ],
  "license": "MIT",
  "author": "Sidhanshu Monga",
  "homepage": "https://www.mindra.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhanshumonga/mindra-dev.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sidhanshumonga/mindra-dev/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@mindra/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/add-use-client.mjs",
    "prepublishOnly": "npm run build"
  }
}
